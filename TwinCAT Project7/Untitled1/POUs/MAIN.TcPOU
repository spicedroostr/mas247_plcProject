<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MAIN" Id="{75317203-8f43-4932-aa88-c7b05e9ca563}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// Valves
	fbFV1        : FB_Valve;
	fbLV1        : FB_Valve;
	fbLV2        : FB_Valve;
	fbLV3        : FB_Valve;
	fbAirValve   : FB_Valve;
	fbMixerValve : FB_Valve;

	// Pump motor
	fbMotor : FB_Motor;

	// LT2 -> LV2 level controller
	fbLevelPI : PI_Function_Block;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// MAIN only reads inputs, calls the objects and writes outputs.
// HMI tags are in GVL_HMI, hardware I/O in GVL_IO.

// ---------------------------------------------------------------- Inputs
GVL_HMI.stLT1.iRaw  := GVL_IO.Level_Transmitter_1;
GVL_HMI.stLT2.iRaw  := GVL_IO.Level_Transmitter_2;
GVL_HMI.stPT1.iRaw  := GVL_IO.Pressure_Transmitter_1;
GVL_HMI.stPT2.iRaw  := GVL_IO.Pressure_Transmitter_2;
GVL_HMI.stPT3.iRaw  := GVL_IO.Pressure_Transmitter_3;
GVL_HMI.stPDT1.iRaw := GVL_IO.Pressure_Differencial_Transmitter_1;
GVL_HMI.stPDT2.iRaw := GVL_IO.Pressure_Differencial_Transmitter_2;
GVL_HMI.stTT1.iRaw  := GVL_IO.Temperature_Transmitter;

GVL_HMI.stLT1.rValue  := F_RawToPercent(GVL_HMI.stLT1.iRaw);
GVL_HMI.stLT2.rValue  := F_RawToPercent(GVL_HMI.stLT2.iRaw);
GVL_HMI.stPT1.rValue  := F_RawToPercent(GVL_HMI.stPT1.iRaw);
GVL_HMI.stPT2.rValue  := F_RawToPercent(GVL_HMI.stPT2.iRaw);
GVL_HMI.stPT3.rValue  := F_RawToPercent(GVL_HMI.stPT3.iRaw);
GVL_HMI.stPDT1.rValue := F_RawToPercent(GVL_HMI.stPDT1.iRaw);
GVL_HMI.stPDT2.rValue := F_RawToPercent(GVL_HMI.stPDT2.iRaw);
GVL_HMI.stTT1.rValue  := F_RawToPercent(GVL_HMI.stTT1.iRaw);

// ---------------------------------------------------------------- Level control
fbLevelPI(
	Setpoint := GVL_HMI.stLevelControl.rSetpoint,
	Actual   := GVL_HMI.stLT2.rValue,
	Kp       := GVL_HMI.stLevelControl.rKp,
	Ti       := GVL_HMI.stLevelControl.rTi,
	Bias     := GVL_HMI.stLevelControl.rBias,
	bEnable  := GVL_HMI.stLevelControl.bEnable);

GVL_HMI.stLevelControl.rActual := GVL_HMI.stLT2.rValue;
GVL_HMI.stLevelControl.rError  := fbLevelPI.Error;
GVL_HMI.stLevelControl.rOutput := fbLevelPI.Output;

// ---------------------------------------------------------------- Valves
// Auto setpoints other than LV2 come from the sequence FB (section D)
fbFV1(stHmi := GVL_HMI.stFV1, rAutoSP := 100.0);
fbLV1(stHmi := GVL_HMI.stLV1, rAutoSP := 100.0);
fbLV2(stHmi := GVL_HMI.stLV2, rAutoSP := fbLevelPI.Output);
fbLV3(stHmi := GVL_HMI.stLV3, rAutoSP := 0.0);
fbAirValve(stHmi := GVL_HMI.stAirValve, rAutoSP := 0.0);
fbMixerValve(stHmi := GVL_HMI.stMixerValve, rAutoSP := 0.0);

// ---------------------------------------------------------------- Motor
// Emergency stop is NC: FALSE means pressed
fbMotor(stHmi := GVL_HMI.stMotor, bInterlock := NOT GVL_IO.EMERGENCY_STOP);

// ---------------------------------------------------------------- Outputs
GVL_IO.Flow_Valve_1    := fbFV1.iRawOut;
GVL_IO.Level_Valve_1   := fbLV1.iRawOut;
GVL_IO.Level_Valve_2   := fbLV2.iRawOut;
GVL_IO.Level_Valve_3   := fbLV3.iRawOut;
GVL_IO.Gas_Valve       := fbAirValve.iRawOut;
GVL_IO.Mixer_Valve     := fbMixerValve.iRawOut;
GVL_IO.Motor_ON_OFF    := fbMotor.bOn;
GVL_IO.Motor_Direction := fbMotor.bReverse;
GVL_IO.Motor_speed     := fbMotor.iRawSpeed;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>