<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MAIN" Id="{75317203-8f43-4932-aa88-c7b05e9ca563}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	//Linking variables to IO cards
	Flow_Valve_1 AT %Q* : INT;
	Level_Valve_1 AT %Q* : INT;
	Level_Valve_2 AT %Q* : INT;
	Level_Valve_3 AT %Q* : INT;
	Gas_Valve AT %Q* : INT;
	Mixer_Valve AT %Q* : INT;
	Motor_speed AT %Q* : INT;
	Motor_ON_OFF AT %Q* :BOOL;
	Motor_Direction AT %Q* :BOOL; 
	Start_Button AT %I* :BOOL;
	Stop_Button AT %I* : BOOL; 
	EMERGENCY_STOP AT %I* : BOOL; 
	Level_Transmitter_1 AT %I* :INT; 
	Level_Transmitter_2 AT %I* :INT; 
	Temperature_Transmitter AT %I* :INT;  
	Pressure_Differencial_Transmitter_1 AT %I* : INT;
	Pressure_Differencial_Transmitter_2 AT %I* : INT;
	Pressure_Transmitter_1 AT %I* : INT ; 
	Pressure_Transmitter_2 AT %I* : INT ; 
	Pressure_Transmitter_3 AT %I* : INT ; 

	
	//User Input as percentage
	Flow_Valve_1_Percentage: INT :=100;
	Level_Valve_1_Percentage: INT  := 0;
	Level_Valve_2_Percentage: INT := 0;
	Level_Valve_3_Percentage: INT := 0;
	Motor_speed_Percentage: INT := 0;
	Motor_ON : BOOL ;
	ON_OFF : STRING(10) := 'OFF' ; 
	
	//Scaled values
	Level_Transmitter_1_Scaled : REAL;
	Level_Transmitter_2_Scaled : REAL;
	Pressure_Differential_Transmitter_1_Scaled : REAL;
	Pressure_Differential_Transmitter_2_Scaled : REAL;
	
	//PI function block instantiation
	PI_Controller : PI_Function_Block;
	
	//PI controller on/off state
	bControllerActive : BOOL;
	

    Scale_PT1 : FB_Scale;
	Scale_PT2 : FB_Scale;
	Scale_PT3 : FB_Scale;
	Scale_PDT1: FB_Scale;
	Scale_PDT2: FB_Scale;
    Scale_TT1 : FB_Scale;
	Scale_LT1 : FB_Scale;
	Scale_LT2 : FB_Scale;
    
    Pressure_1_Bar_Scaled : REAL;
	Pressure_2_Bar_Scaled : REAL;
	Pressure_3_Bar_Scaled : REAL;
    Temperature_1_Scaled  : REAL;

	

    bAlarmReset    : BOOL;      // Reset-knapp fra HMI

	fbTempAlarm    : FB_Alarm;
	fbPressAlarm   : FB_Alarm;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// skalerer, regulerer og sender ut signaler

Scale_LT1(RawValue := Level_Transmitter_1, 
          PhysMin := 0.0, 
          PhysMax := 100.0, 
          ScaledValue => Level_Transmitter_1_Scaled);

Scale_LT2(RawValue := Level_Transmitter_2, 
          PhysMin := 0.0, 
          PhysMax := 100.0, 
          ScaledValue => Level_Transmitter_2_Scaled);
		  
// Oppgitt i prosent, fordi de reelle verdiene ikke er kjent.
Scale_PDT1(RawValue := Pressure_Differencial_Transmitter_1, 
          PhysMin := 0.0, 
          PhysMax := 100.0, 
          ScaledValue => Pressure_Differential_Transmitter_1_Scaled);
		  
Scale_PDT2(RawValue := Pressure_Differencial_Transmitter_2, 
          PhysMin := 0.0, 
          PhysMax := 100.0, 
          ScaledValue => Pressure_Differential_Transmitter_2_Scaled);

// Skaler PT1 (f.eks. 0 til 6 bar)
Scale_PT1(RawValue := Pressure_Transmitter_1, 
          PhysMin := 0.0, 
          PhysMax := 6.0, 
          ScaledValue => Pressure_1_Bar_Scaled);
		  
Scale_PT2(RawValue := Pressure_Transmitter_2, 
          PhysMin := 0.0, 
          PhysMax := 6.0, 
          ScaledValue => Pressure_2_Bar_Scaled);
		  
Scale_PT3(RawValue := Pressure_Transmitter_3, 
          PhysMin := 0.0, 
          PhysMax := 6.0, 
          ScaledValue => Pressure_3_Bar_Scaled);

// Skaler TT1 (f.eks. -200 til 850 grader)
Scale_TT1(RawValue := Temperature_Transmitter, 
          PhysMin := -200.0, 
          PhysMax := 850.0, 
          ScaledValue => Temperature_1_Scaled);
		  
// PI-Controller
PI_Controller(Actual := Level_Transmitter_2_scaled,
bEnable := bControllerActive);
Level_Valve_2_Percentage := REAL_TO_INT(PI_Controller.Output);


// variable interval for Flow_Valve_1_Percentage  form 0 to 100  
IF Flow_Valve_1_Percentage > 100 THEN
	Flow_Valve_1_Percentage := 100; 
	ELSE IF Flow_Valve_1_Percentage < 0 THEN 
		Flow_Valve_1_Percentage := 0; 
	END_IF
	
END_IF

// variable interval for Level_Valve_1_Percentage  form 0 to 100  
IF Level_Valve_1_Percentage > 100 THEN
	Level_Valve_1_Percentage := 100; 
	ELSE IF Level_Valve_1_Percentage < 0 THEN 
		Level_Valve_1_Percentage := 0; 
	END_IF
	
END_IF

// variable interval for Level_Valve_2_Percentage  form 0 to 100 
IF Level_Valve_2_Percentage > 100 THEN
	Level_Valve_2_Percentage := 100; 
	ELSE IF Level_Valve_2_Percentage < 0 THEN 
		Level_Valve_2_Percentage := 0; 
	END_IF
	
END_IF

// variable interval for Level_Valve_3_Percentage  form 0 to 100 
IF Level_Valve_3_Percentage > 100 THEN
	Level_Valve_3_Percentage := 100; 
	ELSE IF Level_Valve_3_Percentage < 0 THEN 
		Level_Valve_3_Percentage := 0; 
	END_IF
	
END_IF



// variable interval for Motor_speed_Percentage  form 0 to 100 
IF Motor_speed_Percentage > 100 THEN
	Motor_speed_Percentage := 100; 
	ELSE IF Motor_speed_Percentage < 0 THEN 
		Motor_speed_Percentage := 0; 
	END_IF
	
END_IF

// Flow_Valve_1 calibration
Flow_Valve_1 := REAL_TO_INT (262.14*Flow_Valve_1_Percentage +6553 ); 

// Level_Valve_1 calibration
Level_Valve_1 := REAL_TO_INT(262.14*Level_Valve_1_Percentage +6553);

// Level_Valve_2 calibration
Level_Valve_2 := REAL_TO_INT(262.14*Level_Valve_2_Percentage +6553);

// Level_Valve_3 calibration
Level_Valve_3 := REAL_TO_INT(262.14*Level_Valve_3_Percentage +6553);


// Motor_speed calibration
Motor_speed := REAL_TO_INT(262.14*Motor_speed_Percentage +6553);

 
IF Motor_ON_OFF   THEN
    Motor_ON   :=  FALSE;
	ON_OFF  := 'MOTOR: ON' ;
	
ELSE
    Motor_ON  := TRUE;
	ON_OFF  := 'MOTOR: OFF' ;
END_IF


fbTempAlarm(rValue := Temperature_1_Scaled, rLimit := 80.0, bReset := bAlarmReset);
fbPressAlarm(rValue := Pressure_1_Bar_Scaled, rLimit := 4.0, bReset := bAlarmReset);





 

	








]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>