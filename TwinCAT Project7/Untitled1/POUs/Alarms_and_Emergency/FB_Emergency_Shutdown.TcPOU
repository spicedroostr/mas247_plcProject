    <Declaration><![CDATA[FUNCTION_BLOCK FB_Emergency_Shutdown
VAR_INPUT
END_VAR
VAR_OUTPUT
	bTrip : BOOL;          // TRUE = systemet skal stoppes
END_VAR
VAR_IN_OUT
	Motor_ON_OFF      : BOOL;
	bControllerActive : BOOL;
	Motor_speed       : INT;
	Gas_Valve         : INT;
	Flow_Valve_1      : INT;
	Level_Valve_1     : INT;
	Level_Valve_2     : INT;
	Level_Valve_3     : INT;
END_VAR

//MAIN . fbPressAlarm . bAlarm
 //│          │           │
// │          │           └─ variabelen bAlarm inne i den blokken
// │          └─ instansen fbPressAlarm, som er deklarert i MAIN
// └─ programmet MAIN

//Instans: typen er en funksjonsblokk. Den holder en hel pakke, med innganger, utganger og internt minne, og den har kode som kan kjøres.

// Gas_Valve := REAL_TO_INT(262.14 * Prosent + 6553);

// Setter maskinen i safe state
VAR
	fbTripLatch: SR;
END_VAR]]></Declaration>
